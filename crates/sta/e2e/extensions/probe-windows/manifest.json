{
  "manifest_version": 3,
  "name": "sta probe: windows",
  "version": "1.0",
  "description": "sta end-to-end test extension: opens Chrome windows and tabs when a test asks.",
  "key": "",
  "background": { "service_worker": "sw.js" },
  "permissions": ["tabs", "identity", "storage"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": { "16": "icon16.png", "48": "icon48.png" },
  "action": { "default_popup": "popup.html", "default_title": "sta probe", "default_icon": { "16": "icon16.png" } },
  "web_accessible_resources": [{ "resources": ["welcome.html"], "matches": ["<all_urls>"] }],
  "incognito": "spanning"
}
